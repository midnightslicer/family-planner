<% content_for :title, "Invitations" %>
<%= render "admin/tabs" %>
<div class="page-header">
  <h1>Invitations</h1>
  <%= link_to "Invite someone", new_admin_invitation_path, class: "btn btn-primary" %>
</div>

<div class="table-wrap">
<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Household</th>
      <th>Invited by</th>
      <th>Status</th>
      <th>Expires</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @invitations.each do |invitation| %>
      <tr>
        <td><%= invitation.email.presence || "Link only" %></td>
        <td><%= invitation.household.name %></td>
        <td><%= invitation.invited_by&.display_name || "Unknown" %></td>
        <td><span class="status-chip status-<%= invitation.accepted? ? "completed" : (invitation.expired? ? "undone" : "planned") %>"><%= invitation.status %></span></td>
        <td><%= invitation.expires_at.strftime("%b %-d, %Y") %></td>
        <td class="table-actions">
          <% if invitation.pending? %>
            <%= button_to "Resend", resend_admin_invitation_path(invitation), method: :post, class: "btn btn-quiet btn-small" %>
          <% end %>
          <%= button_to "Revoke", admin_invitation_path(invitation), method: :delete, class: "btn btn-danger btn-small", form: { data: { turbo_confirm: "Revoke this invitation?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>