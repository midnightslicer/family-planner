<% content_for :title, @household.name %>
<%= render "admin/tabs" %>
<h1><%= @household.name %></h1>

<%= render "shared/form_errors", object: @household %>

<%= render "shared/wall_link", household: @household %>

<section class="account-section">
  <h2>Members</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Lives at</th><th></th></tr></thead>
      <tbody>
        <% @members.each do |membership| %>
          <tr>
            <td><%= membership.user.display_name %></td>
            <td><%= membership.user.email %></td>
            <td>
              <%= form_with model: membership, url: admin_household_membership_path(@household, membership), method: :patch,
                            data: { controller: "autosubmit" } do |f| %>
                <%= f.label :home_id, "#{membership.user.display_name} lives at", class: "visually-hidden", for: "home_#{membership.id}" %>
                <%= f.select :home_id, options_for_select([["Not set", ""]] + @household.locations.where(kind: "house").order(:name).map { |h| [h.name, h.id] }, membership.home_id),
                             {}, id: "home_#{membership.id}", data: { action: "change->autosubmit#submit" } %>
              <% end %>
            </td>
            <td class="table-actions">
              <%= button_to "Remove", admin_household_membership_path(@household, membership), method: :delete,
                            class: "btn btn-danger btn-small",
                            form: { data: { turbo_confirm: "Remove #{membership.user.display_name} from #{@household.name}? Their account stays." } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p><%= link_to "Invite someone to #{@household.name}", new_admin_invitation_path, class: "btn" %></p>
</section>

<section class="account-section">
  <h2>Rename</h2>
  <div class="form-card">
    <%= form_with model: @household, url: admin_household_path(@household), method: :patch do |f| %>
      <div class="form-field">
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, required: true, maxlength: 80 %>
      </div>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</section>

<section class="account-section">
  <h2>Delete</h2>
  <%= button_to "Delete household", admin_household_path(@household), method: :delete, class: "btn btn-danger",
                form: { data: { turbo_confirm: "Delete #{@household.name} and all its tasks? This can't be undone." } } %>
</section>
