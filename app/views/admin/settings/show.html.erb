<% content_for :title, "Settings" %>
<%= render "admin/tabs" %>
<h1>Settings</h1>

<div class="form-card">
  <%= form_with url: admin_settings_path, method: :patch, scope: :settings do |f| %>
    <div class="form-field">
      <%= f.label :app_name, "Board name" %>
      <%= f.text_field :app_name, value: @settings["app_name"], placeholder: AppSettings::DEFAULT_APP_NAME %>
    </div>
    <div class="form-field">
      <%= f.label :app_url, "Public address" %>
      <%= f.url_field :app_url, value: @settings["app_url"], placeholder: "https://status.example.com" %>
      <small>Used for links in emails.<%= " Currently overridden by the APP_URL environment variable." if ENV["APP_URL"].present? %></small>
    </div>

    <fieldset class="form-field">
      <legend>Email (optional)</legend>
      <p><small>
        Needed for emailed invitations and password resets. Without it, invitations give you a link to
        share yourself. Any SMTP service works (your email provider, Resend, Postmark, Mailgun...).
        SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD and SMTP_FROM environment variables fill in anything left blank.
      </small></p>
      <div class="form-field">
        <%= f.label :smtp_host, "SMTP host" %>
        <%= f.text_field :smtp_host, value: @settings["smtp_host"], placeholder: "smtp.example.com", autocapitalize: "none" %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_port, "SMTP port" %>
        <%= f.number_field :smtp_port, value: @settings["smtp_port"], placeholder: "587", min: 1, max: 65535 %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_user, "SMTP username" %>
        <%= f.text_field :smtp_user, value: @settings["smtp_user"], autocomplete: "off", autocapitalize: "none" %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_password, "SMTP password" %>
        <%= f.password_field :smtp_password, autocomplete: "new-password",
                                             placeholder: (@password_saved ? "Saved; leave blank to keep it" : "") %>
        <% if @password_saved %>
          <label class="inline-check"><%= f.check_box :clear_smtp_password, {}, "1", nil %> Remove the saved password</label>
        <% end %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_from, "From address" %>
        <%= f.text_field :smtp_from, value: @settings["smtp_from"], placeholder: "Family Board <board@example.com>" %>
      </div>
      <div class="form-field">
        <%= f.check_box :smtp_tls, { checked: @smtp_tls }, "1", "0" %>
        <%= f.label :smtp_tls, "Use implicit TLS (usually port 465; port 587 uses STARTTLS automatically)" %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit "Save settings", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<div class="form-card">
  <p>Check the email settings by sending a message to <strong><%= current_user.email %></strong>. Save first.</p>
  <%= button_to "Send test email", test_email_admin_settings_path, method: :post, class: "btn" %>
</div>
