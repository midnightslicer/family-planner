<h1>App settings</h1>

<div class="form-card">
  <%= form_with url: admin_settings_path, method: :patch, scope: :settings do |f| %>
    <div class="form-field">
      <%= f.label :app_name, "App name" %>
      <%= f.text_field :app_name, value: @settings["app_name"] %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_host, "SMTP host" %>
      <%= f.text_field :smtp_host, value: @settings["smtp_host"] %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_port, "SMTP port" %>
      <%= f.text_field :smtp_port, value: @settings["smtp_port"] %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_user, "SMTP user" %>
      <%= f.text_field :smtp_user, value: @settings["smtp_user"] %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_password, "SMTP password" %>
      <%= f.text_field :smtp_password, value: @settings["smtp_password"], type: :password %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_from, "From address" %>
      <%= f.text_field :smtp_from, value: @settings["smtp_from"] %>
    </div>
    <div class="form-field">
      <%= f.label :smtp_tls do %>
        <%= f.check_box :smtp_tls, checked: @settings["smtp_tls"] == "true" %> Use TLS
      <% end %>
    </div>
    <div class="form-actions">
      <%= f.submit "Save settings", class: "btn btn-primary" %>
      <%= button_to "Send test email", test_email_admin_settings_path, method: :post, class: "btn" %>
    </div>
  <% end %>
</div>