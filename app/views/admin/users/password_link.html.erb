<% content_for :title, "Password reset link" %>
<%= render "admin/tabs" %>
<h1>Password reset link for <%= @user.display_name %></h1>
<p class="page-intro">
  Send this to <%= @user.display_name %> yourself. It lets them choose a new password, works once, and
  expires in <%= distance_of_time_in_words(Devise.reset_password_within) %>. Making another link cancels this one.
</p>
<div class="form-card" data-controller="clipboard">
  <div class="copy-field">
    <input type="text" value="<%= @reset_url %>" readonly aria-label="Password reset link" data-clipboard-target="source">
    <button type="button" class="btn" data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
  </div>
</div>
<p><%= link_to "Back to people", admin_users_path, class: "btn btn-quiet" %></p>
