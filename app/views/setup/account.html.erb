<h1>Create your admin account</h1>
<p class="page-intro">Step 2 of 2: this will be the first user and administrator of <%= @app_name %></p>

<%= render "shared/form_errors", object: @user %>

<div class="form-card">
  <%= form_with model: @user, url: setup_account_path, method: :post do |f| %>
    <div class="form-field">
      <%= f.label :display_name, "Display name" %>
      <%= f.text_field :display_name, placeholder: "e.g. Alex Smith" %>
    </div>
    <div class="form-field">
      <%= f.label :handle, "Handle" %>
      <%= f.text_field :handle, placeholder: "e.g. alex" %>
      <small>Lowercase letters, numbers, underscores.</small>
    </div>
    <div class="form-field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>
    <div class="form-field">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password %>
    </div>
    <div class="form-field">
      <%= f.label :password_confirmation, "Password confirmation" %>
      <%= f.password_field :password_confirmation %>
    </div>
    <div class="form-field">
      <%= f.label :color, "Your color" %>
      <%= render "shared/color_picker", form: f %>
    </div>
    <div class="form-actions">
      <%= f.submit "Create account", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>