<% content_for :title, "Set up" %>
<h1>Welcome! Let's set up your board</h1>
<p class="page-intro">This takes about a minute. You'll be the admin, and you can invite everyone else next.</p>

<%= render "shared/form_errors", object: @user %>

<div class="form-card">
  <%= form_with model: @user, url: setup_path, method: :post,
                data: { controller: "passkey-signup", passkey_signup_options_url_value: setup_passkey_options_path } do |f| %>
    <div class="form-field">
      <%= label_tag :household_name, "Household name" %>
      <%= text_field_tag :household_name, @household_name, placeholder: "e.g. The Smiths", required: true, maxlength: 80, autofocus: true %>
      <small>Shown at the top of the board. You can rename it later.</small>
    </div>
    <div class="form-field">
      <%= f.label :display_name, "Your name" %>
      <%= f.text_field :display_name, placeholder: "e.g. Alex", required: true, maxlength: 60, autocomplete: "name" %>
    </div>
    <div class="form-field">
      <%= f.label :email, "Your email" %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
      <small>For signing in and password resets.</small>
    </div>

    <%= render "shared/signup_credentials", form: f %>

    <fieldset class="form-field">
      <legend>Your color on the board</legend>
      <%= render "shared/color_picker", form: f %>
    </fieldset>

    <div class="form-actions">
      <%= f.submit "Create my account", class: "btn btn-primary",
                   data: { passkey_signup_target: "submit", passkey_label: "Create account with a passkey", password_label: "Create my account" } %>
      <button type="button" class="btn btn-quiet" data-passkey-signup-target="toggle" data-action="passkey-signup#toggle" hidden>Use a password instead</button>
    </div>
  <% end %>
</div>
