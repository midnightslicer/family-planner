<h1>Set up <%= Setting.get("app_name").presence || "Family Status" %></h1>
<p class="page-intro">Step 1 of 2: app settings and email</p>

<div class="form-card">
  <%= form_with url: setup_settings_path, method: :patch, scope: :settings do |f| %>
    <div class="form-field">
      <%= f.label :app_name, "App name" %>
      <%= f.text_field :app_name, value: @settings["app_name"], placeholder: "e.g. The Smiths" %>
    </div>
    <fieldset class="form-field">
      <legend>SMTP (email for invitations and password resets)</legend>
      <div class="form-field">
        <%= f.label :smtp_host, "SMTP host" %>
        <%= f.text_field :smtp_host, value: @settings["smtp_host"], placeholder: "smtp.example.com" %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_port, "SMTP port" %>
        <%= f.text_field :smtp_port, value: @settings["smtp_port"], placeholder: "587" %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_user, "SMTP user" %>
        <%= f.text_field :smtp_user, value: @settings["smtp_user"] %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_password, "SMTP password" %>
        <%= f.text_field :smtp_password, value: @settings["smtp_password"], type: :password %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_from, "From address" %>
        <%= f.text_field :smtp_from, value: @settings["smtp_from"], placeholder: "status@example.com" %>
      </div>
      <div class="form-field">
        <%= f.label :smtp_tls do %>
          <%= f.check_box :smtp_tls, checked: @settings["smtp_tls"] == "true" %> Use TLS
        <% end %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit "Save and continue", class: "btn btn-primary" %>
    </div>
  <% end %>
  <div class="form-actions">
    <%= button_to "Send test email", setup_test_email_path, method: :post, class: "btn" %>
  </div>
</div>