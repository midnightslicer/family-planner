<!DOCTYPE html>
<html>
  <head>
    <%# safe_join: content_for is already escaped; a plain join would escape it twice ("Mom&#39;s day"). %>
    <title><%= safe_join([content_for(:title), app_name].compact, " · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="<%= PwaController.short_name(app_name) %>">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%# The browser bar / status bar colour of the installed app: --surface,
        light then dark, from the signed-in person's theme (ThemeHelper). %>
    <meta name="theme-color" content="<%= theme_surface(:light) %>" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="<%= theme_surface(:dark) %>" media="(prefers-color-scheme: dark)">
    <%# Makes the app installable; application.js registers the service worker
        only on pages that have this link (not the wall). %>
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <% if user_signed_in? && (push_key = PushKeys.public_key) %>
      <%# Read by lib/push.js: the key this device subscribes against, and whose device it is. %>
      <meta name="push-key" content="<%= push_key %>">
      <meta name="push-user" content="<%= current_user.id %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# Their profile colour, as accent and tint tokens (after the stylesheet, so it wins). %>
    <%= theme_tokens_tag %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <nav class="nav">
      <div class="nav-inner">
        <%= render "layouts/nav" %>
      </div>
    </nav>

    <%# Always rendered, so a turbo stream can prepend a flash into #flash. %>
    <div class="flash-stack" id="flash">
      <%= flash_message(notice, :notice) if notice %>
      <%= flash_message(alert, :alert) if alert %>
    </div>

    <% if user_signed_in? %>
      <%# In-page notifications (Notifier) arrive here as toasts while the app is open. %>
      <%= turbo_stream_from current_user, :notifications %>
      <div id="notifications" class="toast-stack" aria-live="polite"></div>
      <div hidden data-controller="push-sync" data-push-sync-url-value="<%= push_subscriptions_path %>"></div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
