<% content_for :title, "Sign in" %>
<h1>Sign in</h1>

<div class="form-card" data-controller="passkey-login"
     data-passkey-login-options-url-value="<%= user_passkey_options_path %>"
     data-passkey-login-create-url-value="<%= user_passkey_session_path %>">
  <div class="passkey-signin">
    <button type="button" class="btn btn-primary btn-block" data-passkey-login-target="button" data-action="passkey-login#signIn" hidden>
      Sign in with a passkey
    </button>
    <p class="flash-alert" data-passkey-login-target="error" role="alert" hidden></p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-field">
      <%= f.label :email %>
      <%# "webauthn" lets saved passkeys appear in this field's autofill. %>
      <%= f.email_field :email, autofocus: true, autocomplete: "username webauthn", required: true %>
    </div>
    <div class="form-field">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "current-password", required: true %>
    </div>
    <div class="form-field">
      <%= f.check_box :remember_me, checked: true %>
      <%= f.label :remember_me, "Keep me signed in on this device" %>
    </div>
    <div class="form-actions">
      <%= f.submit "Sign in", class: "btn btn-primary" %>
    </div>
  <% end %>
  <%= render "users/shared/links" %>
  <p class="devise-links"><small>New here? Accounts are by invitation; ask whoever runs this board for a link.</small></p>
</div>
