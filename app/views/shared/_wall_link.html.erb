<%# The household's wall (tablet) link. Locals: household. Shown on the
    account page for every member and on Admin > Households. %>
<section class="account-section" id="wall">
  <h2><%= icon(:tablet) %>Wall display<% if local_assigns[:name_household] %>: <%= household.name %><% end %></h2>
  <p class="page-intro">
    Open this link on a tablet or spare screen, sign in once, then install it: <strong>Install app</strong> in
    Chrome, or <strong>Share, Add to Home Screen</strong> in Safari. It opens full screen from its own icon,
    updates live and stays signed in. Only people in this household who are signed in can see it.
  </p>
  <div class="form-card" data-controller="clipboard">
    <div class="copy-field">
      <input type="text" value="<%= wall_url(household.slug, **AppSettings.url_options) %>" readonly
             aria-label="Wall link" data-clipboard-target="source">
      <button type="button" class="btn" data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
      <%= link_to wall_path(household.slug), class: "btn btn-quiet", target: "_blank", rel: "noopener" do %><%= icon_label(:external, "Open") %><% end %>
    </div>
  </div>
</section>
