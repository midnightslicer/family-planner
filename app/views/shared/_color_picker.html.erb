<%# Shared color picker: curated palette grid plus custom hex input.
    Locals: form (a FormBuilder with a `color` field). %>
<div class="color-picker">
  <div class="palette" role="radiogroup" aria-label="Color">
    <% ApplicationHelper::PALETTE.each do |hex| %>
      <label class="swatch" style="background: <%= hex %>" title="<%= hex %>">
        <%= form.radio_button :color, hex, checked: (form.object.color || ApplicationHelper::PALETTE.first) == hex, "aria-label": hex %>
      </label>
    <% end %>
  </div>
  <details class="custom-color">
    <summary>Custom color</summary>
    <%= form.label :color, "Hex value", value: nil %>
    <%= form.text_field :color, placeholder: "#6366f1", pattern: "#[0-9a-fA-F]{6}", id: "#{form.object_name}_color_custom" %>
  </details>
</div>
