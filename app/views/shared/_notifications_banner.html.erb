<%# Web notifications opt-in banner. Never auto-prompts. %>
<div class="invite-banner" data-controller="notifications" data-notifications-target="banner">
  <p>Want a nudge when someone assigns you a task or a status changes?</p>
  <div class="invite-actions">
    <button type="button" class="btn btn-primary" data-action="notifications#enable">Enable notifications</button>
    <button type="button" class="btn btn-quiet" data-action="notifications#enable">No thanks</button>
  </div>
</div>