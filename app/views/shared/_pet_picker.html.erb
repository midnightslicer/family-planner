<%# Pick pets as big photo tiles (checkboxes). Lives inside a form with the
    `picker` controller. Locals: pets, statuses, chosen (ids), meta (:where
    or :fed: what the line under each name shows). %>
<fieldset class="form-field picker-field">
  <legend>Which pets?</legend>
  <div class="picker-shortcuts" data-picker-target="shortcuts" hidden>
    <button type="button" class="btn btn-small btn-quiet" data-action="picker#all">All</button>
    <button type="button" class="btn btn-small btn-quiet" data-action="picker#none">None</button>
  </div>
  <div class="pick-grid">
    <% pets.each do |pet| %>
      <% status = statuses.fetch(pet.id) %>
      <label class="pick-tile">
        <input type="checkbox" name="check_in[pet_ids][]" value="<%= pet.id %>" <%= "checked" if chosen.include?(pet.id) %>
               data-picker-target="option" data-action="picker#update">
        <span class="pick-check" aria-hidden="true"><%= icon(:check) %></span>
        <span class="person-avatar" style="<%= PetsHelper::PET_DISC_STYLE %>" aria-hidden="true"><%= pet_avatar_content(pet) %></span>
        <span class="pick-name"><%= pet.name %></span>
        <span class="pick-meta">
          <% if meta == :fed %>
            <%= status.tracks_meals? ? "#{status.fed_today} of #{status.meals} today" : "Not fed here" %>
          <% else %>
            <%= status.report ? (status.report.location&.name || "Somewhere else") : "Unknown" %>
          <% end %>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
