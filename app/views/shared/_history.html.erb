<%# A timeline of LocationReports and Feedings, newest first. Whoever made
    an entry (or an admin) can take it back. Locals: entries. %>
<ol class="history">
  <% entries.each do |entry| %>
    <% feeding = entry.is_a?(Feeding)
       who = feeding ? entry.fed_by : entry.reported_by %>
    <li class="history-item">
      <span class="history-mark"><%= feeding ? icon(:utensils) : location_icon(entry.location) %></span>
      <div class="history-body">
        <span>
          <% if feeding %>
            <strong>Fed</strong>
          <% else %>
            At <strong><%= entry.location&.name || "somewhere else" %></strong><%= ", #{entry.spot_words}" if entry.spot_words %>
          <% end %>
          <small><%= time_tag_ago(entry.created_at) %><%= " · #{who.display_name}" if who %></small>
        </span>
        <% if entry.comment %><span class="report-comment"><%= icon(:message) %><span><%= entry.comment %></span></span><% end %>
      </div>
      <% if who == current_user || current_user.admin? %>
        <%= button_to (feeding ? feeding_path(entry) : location_report_path(entry)), method: :delete,
                      class: "btn btn-quiet btn-icon btn-icon-danger", title: "Remove", "aria-label": "Remove this entry",
                      form: { data: { turbo_confirm: "Remove this entry?" } } do %><%= icon(:undo) %><% end %>
      <% end %>
    </li>
  <% end %>
</ol>
