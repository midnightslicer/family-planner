<%# A photo field with a crop step (photo_upload_controller.js), shared by
    people, pets and locations. Locals:
      form       the FormBuilder
      attribute  :avatar or :photo (the model uses `small_photo`)
      preview    what the preview shows now (photo or fallback)
      shape      :round (faces, default) or :square (places)
      autosave   save the form as soon as a photo is cropped (default false)
      style      inline custom properties for a round preview (optional)
      hint       the line under the buttons %>
<% record = form.object
   shape = local_assigns.fetch(:shape, :round)
   saved = record.public_send(:"#{attribute}_saved?")
   uid = "#{record.model_name.param_key}_#{attribute}" %>
<div class="form-field" data-controller="photo-upload"
     data-photo-upload-shape-value="<%= shape %>"
     data-photo-upload-size-value="<%= shape == :square ? 480 : 256 %>"
     data-photo-upload-autosave-value="<%= local_assigns.fetch(:autosave, false) %>">
  <%= form.label attribute, "Photo" %>
  <div class="avatar-picker">
    <span class="<%= shape == :square ? 'place-photo' : 'person-avatar' %> avatar-preview" aria-hidden="true"
          data-color-preview data-photo-upload-target="preview" style="<%= local_assigns[:style] %>"><%= preview %></span>
    <div class="avatar-controls">
      <%= form.file_field attribute, accept: SmallPhoto::TYPES.join(","),
                          data: { photo_upload_target: "input", action: "change->photo-upload#open" } %>
      <%# Shown by the controller; without JS the plain file input stays. %>
      <button type="button" class="btn btn-small" hidden
              data-photo-upload-target="choose" data-action="photo-upload#choose">
        <%= icon_label(:camera, saved ? "Change photo" : "Choose a photo") %>
      </button>
      <% if saved %>
        <label class="inline-check">
          <%= form.check_box :"remove_#{attribute}", data: { photo_upload_target: "remove" } %>
          Remove photo
        </label>
      <% end %>
      <small><%= local_assigns[:hint] || "You can crop it first. It's shrunk on your device, so big photos are fine." %></small>
      <p class="flash-alert" data-photo-upload-target="error" role="alert" hidden></p>
    </div>
  </div>

  <dialog class="crop-dialog" aria-labelledby="<%= uid %>_crop_title"
          data-photo-upload-target="dialog" data-action="close->photo-upload#closed">
    <h2 id="<%= uid %>_crop_title">Crop the photo</h2>
    <p class="crop-hint">Drag to move it, zoom to fit. <%= shape == :square ? "The square" : "The circle" %> is what everyone sees.</p>
    <canvas class="crop-stage" tabindex="0" role="img" aria-label="Photo crop area. Arrow keys move it, plus and minus zoom."
            data-photo-upload-target="canvas"
            data-action="pointerdown->photo-upload#grab pointermove->photo-upload#move pointerup->photo-upload#release pointercancel->photo-upload#release wheel->photo-upload#wheel keydown->photo-upload#nudge"></canvas>
    <div class="crop-zoom">
      <%= icon(:zoom_out) %>
      <label class="visually-hidden" for="<%= uid %>_crop_zoom">Zoom</label>
      <input type="range" id="<%= uid %>_crop_zoom" min="1" max="4" step="0.01" value="1"
             data-photo-upload-target="zoom" data-action="input->photo-upload#zoomed">
      <%= icon(:zoom_in) %>
    </div>
    <div class="form-actions">
      <button type="button" class="btn btn-primary" data-action="photo-upload#apply"><%= icon_label(:check, "Use photo") %></button>
      <button type="button" class="btn btn-quiet" data-action="photo-upload#cancel">Cancel</button>
    </div>
  </dialog>
</div>
