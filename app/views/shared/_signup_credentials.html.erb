<%# How a new account will sign in: a passkey (the default where the browser
    supports it) or a password. Without JavaScript, or on plain-http LAN
    installs where passkeys can't work, it's simply a password field.
    Locals: form, options_url (JSON endpoint for passkey registration options). %>
<div data-passkey-signup-target="passwordSection">
  <div class="form-field">
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, autocomplete: "new-password", minlength: Devise.password_length.min,
                              required: true, data: { passkey_signup_target: "password" } %>
    <small><%= Devise.password_length.min %> characters or more.</small>
  </div>
</div>

<div class="passkey-choice" data-passkey-signup-target="passkeySection" hidden>
  <p class="passkey-hint">
    <strong>Sign in with a passkey.</strong> No password to remember: your
    phone or computer unlocks it with Face ID, a fingerprint or your device PIN.
  </p>
  <p class="passkey-error flash-alert" data-passkey-signup-target="error" role="alert" hidden></p>
</div>

<%= hidden_field_tag :passkey_credential, nil, data: { passkey_signup_target: "credential" } %>
