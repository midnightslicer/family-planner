<%# Shared person card: identical on the authenticated dashboard, the public
    kiosk wall and live broadcasts. Locals: user, household, and optionally
    status ({ current:, next: } from Household#member_statuses, which pages
    compute once for every card). %>
<% status = local_assigns[:status] || household.member_statuses[user.id]
   current_task = status[:current]
   next_planned = status[:next] %>
<div class="person-card"
     id="<%= dom_id(user, :person_card) %>"
     data-user-id="<%= user.id %>"
     style="--user-color: <%= user.color %>; --user-fg: <%= contrast_color(user.color) %>">
  <div class="person-identity">
    <span class="person-avatar" aria-hidden="true"><%= initials(user.display_name) %></span>
    <span class="person-meta">
      <span class="person-name"><%= user.display_name %></span>
      <span class="person-handle">@<%= user.handle %></span>
    </span>
  </div>
  <div class="person-status">
    <% if current_task %>
      <span class="status-chip status-in_progress">Busy: <%= current_task.title %></span>
      <% if current_task.ends_at %>
        <span class="task-meta">
          <%= current_task.ends_at.future? ? "#{distance_of_time_in_words(Time.current, current_task.ends_at)} left" : "running over" %>
        </span>
      <% end %>
    <% elsif next_planned %>
      <span class="status-chip status-planned">Up next: <%= next_planned.title %></span>
      <% if next_planned.starts_at %>
        <span class="task-meta"><%= next_planned.starts_at.to_date == Date.current ? next_planned.starts_at.strftime("%H:%M") : next_planned.starts_at.strftime("%a %-d %b, %H:%M") %></span>
      <% end %>
    <% else %>
      <span class="status-chip status-completed">Available</span>
    <% end %>
  </div>
</div>
