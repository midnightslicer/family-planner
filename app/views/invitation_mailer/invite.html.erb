<h1>You're invited to join <%= @app_name %>!</h1>

<p>
  <%= @inviter&.display_name || "The admin" %> has invited you to join the
  household <strong><%= @household.name %></strong> on <%= @app_name %>.
</p>

<% if @note.present? %>
  <blockquote><%= @note %></blockquote>
<% end %>

<p>
  This invitation expires in 7 days and can only be used once.
</p>

<p>
  <%= link_to "Join #{@household.name}", @join_url %>
</p>

<p>
  Or paste this link into your browser:<br>
  <%= @join_url %>
</p>