<h1>You're invited to join <%= @app_name %>!</h1>

<p>
  <%= @inviter&.display_name || "The admin" %> has invited you to join the
  household <strong><%= @household.name %></strong> on <%= @app_name %>.
</p>

<% if @note.present? %>
  <blockquote><%= @note %></blockquote>
<% end %>

<p>
  This invitation expires in 7 days and can only be used once.
</p>

<p>
  <%= link_to "Join #{@household.name}", @join_url %>
</p>

<p>
  Or paste this link into your browser:<br>
  <%= @join_url %>
</p>

<p><strong>Get it on your phone</strong> (once you've joined):</p>
<ul>
  <li><strong>iPhone:</strong> open the link in Safari, tap Share, then Add to Home Screen. Open <%= @app_name %> from your
    Home Screen, go to Notifications in the account menu, and turn them on.</li>
  <li><strong>Android:</strong> open the link in Chrome and choose Install app, then turn notifications on under
    Notifications in the account menu.</li>
</ul>
