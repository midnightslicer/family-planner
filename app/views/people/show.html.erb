<% content_for :title, @person.display_name %>
<%= render "pets/live" %>
<% me = @person == current_user
   here = @status[:location] %>

<header class="profile-header" style="--user-color: <%= @person.color %>; --user-fg: <%= contrast_color(@person.color) %>">
  <span class="person-avatar profile-avatar" aria-hidden="true"><%= avatar_content(@person) %></span>
  <div class="profile-heading">
    <h1><%= @person.display_name %><%= icon(:cake, label: "Birthday today", class: "birthday-cake") if birthday_today?(@person.birthday) %></h1>
    <p class="task-meta">
      <span class="person-handle">@<%= @person.handle %></span>
      <% if @person.birthday %><span><%= icon(:cake) %><%= age_in_words(@person.birthday) %> · born <%= birthday_label(@person.birthday) %></span><% end %>
    </p>
  </div>
  <% if me %>
    <div class="header-actions">
      <%= link_to account_root_path, class: "btn btn-quiet" do %><%= icon_label(:pencil, "Edit profile") %><% end %>
    </div>
  <% end %>
</header>

<div class="profile-panels">
  <section class="panel">
    <h2><%= icon(:map_pin) %><%= me ? "You're at" : "Where" %></h2>
    <% if here %>
      <div class="place-now">
        <%= location_picture(here.location) if here.location %>
        <div>
          <strong><%= here.location&.name || "Somewhere else" %></strong>
          <small><%= time_tag_ago(here.created_at) %></small>
          <% if here.comment %><p class="report-comment"><%= icon(:message) %><span><%= here.comment %></span></p><% end %>
        </div>
      </div>
    <% else %>
      <p class="empty-hint"><%= me ? "You haven't said where you are yet." : "#{@person.display_name} hasn't said where they are." %></p>
    <% end %>
  </section>

  <% if me %>
    <section class="panel panel-wide">
      <h2><%= icon(:send) %>Where are you now?</h2>
      <%= render "shared/form_errors", object: @report %>
      <%= form_with model: @report, url: locate_me_path, method: :post do |f| %>
        <%= render "shared/location_picker", locations: @locations, field_name: "location_report[location_id]",
                   new_name_field: "location_report[new_location_name]", new_name: @new_location_name,
                   selected: (@report.location&.new_record? ? Location::NEW : @report.location_id), legend: "Pick a place" %>
        <div class="form-field">
          <%= f.label :comment, "Comment (optional)" %>
          <%= f.text_field :comment, maxlength: LocationReport::COMMENT_MAX, placeholder: "e.g. Back by 6", autocomplete: "off" %>
        </div>
        <div class="form-actions">
          <%= f.button type: "submit", class: "btn btn-primary btn-wide" do %><%= icon_label(:map_pin, "Update my location") %><% end %>
        </div>
      <% end %>
      <p><small>Only you can set where you are. Everyone in <%= current_household.name %> sees it on the board.</small></p>
    </section>
  <% end %>
</div>

<% if @history.any? %>
  <h2 class="section-title"><%= icon(:clock) %>Recently</h2>
  <%= render "shared/history", entries: @history %>
<% end %>
