<h1><%= action_name == "edit" ? "Edit task" : "New task" %></h1>

<%= render "shared/form_errors", object: @task %>

<div class="form-card">
  <%= form_with model: @task, url: @task.persisted? ? task_path(@task) : tasks_path, method: @task.persisted? ? :patch : :post do |f| %>
    <div class="form-field">
      <%= f.label :title, "Title" %>
      <%= f.text_field :title, placeholder: "e.g. Review budget" %>
    </div>
    <div class="form-field">
      <%= f.label :description, "Description" %>
      <%= f.text_area :description, rows: 3 %>
    </div>
    <div class="form-field">
      <%= f.label :assigned_to_id, "Assigned to" %>
      <%= f.collection_select :assigned_to_id, current_household.users.order(:display_name), :id, :display_name, { selected: (@task.assigned_to_id || current_user.id), include_blank: "Unassigned" } %>
    </div>
    <div class="form-field">
      <%= f.label :starts_at, "Starts at" %>
      <%= f.datetime_local_field :starts_at %>
    </div>
    <div class="form-field">
      <%= f.label :ends_at, "Ends at" %>
      <%= f.datetime_local_field :ends_at %>
    </div>
    <div class="form-field">
      <%= f.label :recurrence_interval, "Repeats" %>
      <%= f.select :recurrence_interval, [["Does not repeat", ""], ["Daily", "daily"], ["Weekly", "weekly"], ["Every 2 weeks", "biweekly"], ["Monthly", "monthly"]], selected: @task.recurrence_interval %>
    </div>
    <div class="form-actions">
      <%= f.submit @task.persisted? ? "Save changes" : "Create task", class: "btn btn-primary" %>
      <%= link_to "Cancel", tasks_path, class: "btn btn-quiet" %>
    </div>
  <% end %>
</div>