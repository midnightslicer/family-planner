<h1><%= @task.persisted? ? "Edit" : "Add something" %></h1>

<%= render "shared/form_errors", object: @task %>

<div class="form-card">
  <%= form_with model: @task do |f| %>
    <div class="form-field">
      <%= f.label :title, "What" %>
      <%= f.text_field :title, required: true, maxlength: 120, placeholder: "e.g. Call the doctor, Church, Grocery run" %>
    </div>
    <div class="form-field">
      <%= f.label :assigned_to_id, "For" %>
      <%= f.collection_select :assigned_to_id, current_household.users.order(:display_name), :id, :display_name,
                              { selected: @task.assigned_to_id, include_blank: "Anyone" } %>
    </div>
    <%= render "tasks/when_fields", form: f %>
    <div class="form-field">
      <%= f.label :description, "Notes (optional)" %>
      <%= f.text_area :description, rows: 3, maxlength: 2000 %>
    </div>
    <div class="form-actions">
      <% if @task.persisted? %>
        <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon_label(:save, "Save changes") %><% end %>
      <% else %>
        <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon_label(:plus, "Add it") %><% end %>
        <%= f.button type: "submit", name: "start_now", value: "1", class: "btn" do %><%= icon_label(:zap, "Add & start now") %><% end %>
      <% end %>
      <%= link_to "Never mind", tasks_path, class: "btn btn-quiet" %>
    </div>
  <% end %>
</div>
