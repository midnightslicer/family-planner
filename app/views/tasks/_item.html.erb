<%# One row on a schedule. To-dos have a tick-off circle; events show their
    time. Locals: task, show_day (events not today show their day),
    schedule_person (whose day this is, so "with" lists the others). %>
<% editable = !task.work? && task.editable_by?(current_user)
   past = task.past? %>
<% if task.work? %>
  <%# Work hours, from the person's work schedule. %>
  <li class="sched-item sched-event sched-work<%= ' is-past' if past %><%= ' is-now' if task.happening_at? %>">
    <span class="sched-time"><%= time_range(task, with_day: :never) %></span>
    <div class="sched-body">
      <span class="sched-title"><%= icon(:briefcase) %>Work</span>
      <span class="sched-meta">
        <% if task.happening_at? %><span class="status-chip status-in_progress">Now</span><% end %>
        <%= availability_chip(task) %>
        <% if task.place_name %><span><%= task.location ? location_icon(task.location) : icon(:map_pin) %><%= task.place_name %></span><% end %>
      </span>
    </div>
    <% if task.user == current_user %>
      <div class="sched-actions">
        <%= link_to edit_work_schedule_path, class: "btn btn-quiet btn-icon", title: "Work schedule", "aria-label": "Edit your work schedule" do %><%= icon(:pencil) %><% end %>
      </div>
    <% end %>
  </li>
<% elsif !task.visible_to?(current_user) %>
  <%# Someone else's private event: when, and how reachable, nothing more. %>
  <li class="sched-item sched-event is-private<%= ' is-past' if past %><%= ' is-now' if task.happening_at? %>" id="<%= dom_id(task) %>">
    <span class="sched-time"><%= time_range(task, with_day: local_assigns[:show_day] ? :unless_today : :never) %></span>
    <div class="sched-body">
      <span class="sched-title"><%= icon(:lock) %>Busy</span>
      <span class="sched-meta"><%= availability_chip(task) %></span>
    </div>
  </li>
<% else %>
<% mine = task.assignment_for(current_user)
   invited = mine&.pending?
   doer = task.doable_by?(current_user)
   others = task.active_assignments.reject { |a| a.user_id == local_assigns[:schedule_person]&.id || (local_assigns[:schedule_person].nil? && a.user_id == current_user.id) } %>
<li class="sched-item <%= task.timed? ? 'sched-event' : 'sched-todo' %> is-<%= task.status %><%= ' is-past' if past && task.open? %><%= ' is-now' if task.happening_at? %>"
    id="<%= dom_id(task) %>">
  <% if task.timed? %>
    <span class="sched-time"><%= time_range(task, with_day: local_assigns[:show_day] ? :unless_today : :never) %></span>
  <% elsif task.open? && doer %>
    <%= button_to complete_task_path(task), method: :post, class: "sched-check", title: "Mark done", "aria-label": "Mark #{task.title} done",
                  data: { controller: "celebrate", action: "click->celebrate#burst" } do %><%= icon(:check) %><% end %>
  <% elsif task.open? %>
    <%# Someone else's to tick off. %>
    <span class="sched-check is-locked" title="Only <%= task.active_assignments.map { |a| a.user.display_name }.to_sentence(two_words_connector: ' or ', last_word_connector: ' or ') %> can tick this off"></span>
  <% else %>
    <span class="sched-check is-checked" aria-hidden="true"><%= icon(task.completed? ? :check : :skip) %></span>
  <% end %>

  <div class="sched-body">
    <span class="sched-title"><%= task.title %><%= icon(:lock, label: "Private", class: "private-mark") if task.private? %></span>
    <span class="sched-meta">
      <% if task.in_progress? %><span class="status-chip status-in_progress">Doing</span><% end %>
      <% if task.happening_at? %><span class="status-chip status-in_progress">Now</span><% end %>
      <% if task.timed? || task.in_progress? %><%= availability_chip(task) %><% end %>
      <% if task.place_name %><span><%= task.location ? location_icon(task.location) : icon(:map_pin) %><%= task.place_name %></span><% end %>
      <% if task.due_on && !task.timed? %><span><%= icon(:calendar) %><%= day_name(task.due_on) %></span><% end %>
      <% unless task.recurs_no_recurrence? %><span class="task-recurrence"><%= icon(:repeat) %><%= task.recurrence_interval.humanize.downcase %></span><% end %>
      <% if task.created_by && task.created_by != current_user && !task.assignment_for(task.created_by) %><span><%= icon(:user) %>from <%= task.created_by.display_name %></span><% end %>
      <% if others.any? %>
        <span class="who-list" title="<%= others.map { |a| "#{a.user.display_name}#{' (waiting)' if a.pending?}" }.join(', ') %>">
          <%= task.active_assignments.size > others.size ? "with" : "for" %>
          <% others.each do |a| %>
            <span class="person-avatar<%= ' is-waiting' if a.pending? %>" style="--user-color: <%= a.user.color %>; --user-fg: <%= contrast_color(a.user.color) %>" aria-hidden="true"><%= avatar_content(a.user) %></span>
          <% end %>
          <span class="visually-hidden"><%= others.map { |a| "#{a.user.display_name}#{' (waiting for their OK)' if a.pending?}" }.to_sentence %></span>
        </span>
      <% end %>
    </span>
    <% if mine&.conflict_note && invited %><span class="sched-conflict"><%= icon(:alert_circle) %><%= mine.conflict_note %></span><% end %>
    <% if task.description.present? %><span class="sched-notes"><%= task.description %></span><% end %>
  </div>

  <% if invited %>
    <div class="sched-actions invite-actions">
      <%= button_to accept_task_path(task), method: :post, class: "btn btn-small btn-primary" do %><%= icon_label(:check, "Accept") %><% end %>
      <%= button_to decline_task_path(task), method: :post, class: "btn btn-small btn-quiet" do %><%= icon_label(:x, "Decline") %><% end %>
    </div>
  <% else %>
  <div class="sched-actions">
    <% if doer && task.open? && !task.timed? %>
      <% if task.in_progress? %>
        <%= button_to pause_task_path(task), method: :post, class: "btn btn-quiet btn-icon", title: "Pause", "aria-label": "Pause" do %><%= icon(:pause) %><% end %>
      <% else %>
        <%= button_to start_task_path(task), method: :post, class: "btn btn-quiet btn-icon", title: "I'm doing this now", "aria-label": "Start #{task.title}" do %><%= icon(:play) %><% end %>
      <% end %>
    <% elsif doer && task.open? && task.timed? %>
      <%= button_to complete_task_path(task), method: :post, class: "btn btn-quiet btn-icon", title: "Mark done", "aria-label": "Mark #{task.title} done" do %><%= icon(:check) %><% end %>
    <% elsif doer && task.reopenable? %>
      <%# Ticked off by mistake: back on the list. %>
      <%= button_to reopen_task_path(task), method: :post, class: "btn btn-quiet btn-icon", title: "Not done after all", "aria-label": "Bring back #{task.title}" do %><%= icon(:undo) %><% end %>
    <% elsif doer && task.restartable? %>
      <%= button_to start_task_path(task), method: :post, class: "btn btn-quiet btn-icon", title: "Do it after all", "aria-label": "Restart #{task.title}" do %><%= icon(:undo) %><% end %>
    <% end %>
    <% if editable %>
      <%= link_to edit_task_path(task), class: "btn btn-quiet btn-icon", title: "Edit", "aria-label": "Edit #{task.title}" do %><%= icon(:pencil) %><% end %>
    <% end %>
    <% if task.open? && mine && task.created_by_id != current_user.id %>
      <%# Someone else put it on your list: you can say no (it stays on theirs). %>
      <%= button_to decline_task_path(task), method: :post, class: "btn btn-quiet btn-icon btn-icon-danger", title: "Decline", "aria-label": "Decline #{task.title}" do %><%= icon(:x) %><% end %>
    <% elsif task.open? && doer %>
      <%= button_to cancel_task_path(task), method: :post, class: "btn btn-quiet btn-icon btn-icon-danger", title: "Skip", "aria-label": "Skip #{task.title}" do %><%= icon(:x) %><% end %>
    <% elsif editable %>
      <%# You added it for someone else (or it's over): take it back. %>
      <%= button_to task_path(task), method: :delete, class: "btn btn-quiet btn-icon btn-icon-danger", title: "Delete", "aria-label": "Delete #{task.title}",
                    form: { data: { turbo_confirm: task.open? ? "Take this back? It comes off their list." : "Delete this for good?" } } do %><%= icon(:trash) %><% end %>
    <% end %>
  </div>
  <% end %>
</li>
<% end %>
