<% content_for :title, "Schedule" %>
<%= render "shared/live" %>
<%= render "tasks/people_switch", members: @members, selected: @person || :family %>

<% if @family %>
  <div class="page-header"><h1>Everyone's day</h1></div>
  <% groups = current_household.by_house(@members, []).reject { |_, people, _| people.empty? }
     grouped = groups.any? { |house, _, _| house } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="60">
  <% groups.each do |house, people, _| %>
  <% if grouped %>
    <h2 class="house-title"><% if house %><%= location_picture(house) %><%= house.name %><% else %><span class="place-photo"><%= icon(:map_pin) %></span>No house set<% end %></h2>
  <% end %>
  <div class="family-grid">
    <% people.each do |member| %>
      <% schedule = @family.fetch(member) %>
      <% status = @statuses[member.id] %>
      <section class="family-column panel" style="--user-color: <%= member.color %>; --user-fg: <%= contrast_color(member.color) %>">
        <%= link_to tasks_path(person: (member.id unless member == current_user)), class: "family-person" do %>
          <span class="person-avatar" aria-hidden="true"><%= avatar_content(member) %></span>
          <span class="person-name"><%= member.display_name %></span>
        <% end %>
        <div class="family-now">
          <%= reach_chip(status) %>
          <% if status[:current] %>
            <p class="person-now"><%= now_line(status[:current], current_user, place: !moved_on?(status)) %></p>
          <% elsif status[:off] %>
            <p class="person-now">Day off<%= " · #{status[:off].note}" if status[:off].note %></p>
          <% end %>
        </div>
        <% if schedule.today.any? %>
          <ol class="family-day">
            <% schedule.today.each do |task| %>
              <li class="<%= 'is-past' if task.past? %><%= ' is-now' if task.happening_at? %><%= ' is-work' if task.work? %>">
                <span class="sched-time"><%= time_range(task, with_day: :never) %></span>
                <span><%= icon(:briefcase) if task.work? %><%= task.title_for(current_user) %><%= " · #{task.place_name}" if task.place_name && task.visible_to?(current_user) %><%= icon(:lock, label: "Private") if task.private? %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="empty-hint">Nothing scheduled today.</p>
        <% end %>
        <% if schedule.todos.any? %>
          <p class="family-todos"><small><%= icon(:list) %><%= pluralize(schedule.todos.size, "to-do") %></small></p>
        <% end %>
      </section>
    <% end %>
  </div>
  <% end %>
  </div>
  <% if @anyone.any? %>
    <h2 class="section-title"><%= icon(:users) %>For anyone</h2>
    <ul class="sched-list"><%= render partial: "tasks/item", collection: @anyone, as: :task %></ul>
  <% end %>
<% else %>
  <% me = @person == current_user
     s = @schedule %>
  <%= render "tasks/person_header", person: @person, where: @where, at: @at, now_task: @schedule.now, locations: @locations, schedule: @schedule, status_set: @status_set %>

  <% if s.now %>
    <div class="now-banner <%= "is-#{s.now.availability}" %>">
      <span class="banner-icon"><%= icon(s.now.timed? ? :clock : :zap) %></span>
      <div>
        <strong><%= me ? "You're on" : "Now" %>: <%= s.now.title_for(current_user) %></strong>
        <small><% if s.now.timed? %>until <%= clock(s.now.finishes_at) %><% else %>started <%= time_tag_ago(s.now.started_at || s.now.updated_at) %><% end %><%= " · #{s.now.place_name}" if s.now.place_name && s.now.visible_to?(current_user) && !@where&.newer_than?(s.now) %></small>
      </div>
      <%= availability_chip(s.now) %>
    </div>
  <% end %>

  <% if s.waiting.any? %>
    <section class="panel waiting-panel">
      <h2><%= icon(:bell) %><%= me ? "Needs your OK" : "Waiting for #{@person.display_name.split.first}'s OK" %> <span class="count"><%= s.waiting.size %></span></h2>
      <ul class="sched-list"><%= render partial: "tasks/item", collection: s.waiting, as: :task, locals: { show_day: true, schedule_person: @person } %></ul>
    </section>
  <% end %>

  <%= render "tasks/quick_add", task: @task, person: @person, selected: @assignee_ids %>

  <div class="schedule-columns" data-controller="auto-refresh" data-auto-refresh-interval-value="60">
    <section class="panel">
      <h2><%= icon(:list) %><%= me ? "To do" : "On their list" %> <span class="count"><%= s.todos.size %></span></h2>
      <% if s.todos.any? %>
        <ul class="sched-list"><%= render partial: "tasks/item", collection: s.todos, as: :task, locals: { schedule_person: @person } %></ul>
      <% else %>
        <p class="empty-hint"><%= icon(:sparkles) %><%= me ? "Nothing on your list. Add anything above, as it comes to you." : "Their list is clear." %></p>
      <% end %>
    </section>

    <section class="panel">
      <h2><%= icon(:calendar) %>Today</h2>
      <% if s.today.any? %>
        <ul class="sched-list"><%= render partial: "tasks/item", collection: s.today, as: :task, locals: { schedule_person: @person } %></ul>
      <% else %>
        <p class="empty-hint">Nothing at a set time today.</p>
      <% end %>
    </section>
  </div>

  <% if s.later.any? || s.days_off.any? %>
    <h2 class="section-title"><%= icon(:calendar) %>Coming up</h2>
    <ul class="sched-list panel">
      <% s.days_off.each do |off| %>
        <li class="sched-item sched-day-off">
          <span class="sched-time"><%= off.single_day? ? day_name(off.starts_on) : "#{day_name(off.starts_on)} – #{day_name(off.ends_on)}" %></span>
          <div class="sched-body"><span class="sched-title"><%= icon(:sun) %>Day off<%= " · #{off.note}" if off.note %></span></div>
        </li>
      <% end %>
      <%= render partial: "tasks/item", collection: s.later, as: :task, locals: { show_day: true, schedule_person: @person } %>
    </ul>
  <% end %>

  <% if s.following.any? %>
    <h2 class="section-title"><%= icon(:bell) %>Following up</h2>
    <ul class="sched-list panel"><%= render partial: "tasks/item", collection: s.following, as: :task, locals: { show_day: true } %></ul>
  <% end %>

  <% done = s.done.reject { |task| s.today.include?(task) } %>
  <% if done.any? %>
    <details class="done-today">
      <summary><%= icon(:check_circle) %>Done today (<%= done.size %>)</summary>
      <ul class="sched-list"><%= render partial: "tasks/item", collection: done, as: :task, locals: { schedule_person: @person } %></ul>
    </details>
  <% end %>
<% end %>
