<% content_for :title, "Schedule" %>
<%= render "shared/live" %>
<%# No cached preview: Turbo would show the snapshot, then morph the fresh
    page onto it, and the morph adds a second permanent quick-add form. %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-preview") %>
<%= render "tasks/people_switch", members: @members, selected: @person || :family %>

<% if @family %>
  <div class="page-header"><h1>Everyone's day</h1></div>
  <% grouped = @groups.any? { |house, _, _| house } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="60">
  <% @groups.each do |house, people, _| %>
  <% if grouped %>
    <h2 class="house-title"><% if house %><%= location_picture(house) %><%= house.name %><% else %><span class="place-photo"><%= icon(:map_pin) %></span>No house set<% end %></h2>
  <% end %>
  <div class="family-grid">
    <% people.each do |member| %>
      <% schedule = @family.fetch(member) %>
      <% status = @statuses[member.id] %>
      <section class="family-column panel" style="--user-color: <%= member.color %>; --user-fg: <%= contrast_color(member.color) %>">
        <%= link_to tasks_path(person: (member.id unless member == current_user)), class: "family-person" do %>
          <span class="person-avatar" aria-hidden="true"><%= avatar_content(member) %></span>
          <span class="person-name"><%= member.display_name %></span>
        <% end %>
        <div class="family-now">
          <%= reach_chip(status) %>
          <% if status[:current] %>
            <p class="person-now"><%= now_line(status[:current], current_user, place: !moved_on?(status)) %></p>
          <% elsif status[:off] %>
            <p class="person-now">Day off<%= " · #{status[:off].note}" if status[:off].note %></p>
          <% end %>
        </div>
        <% if schedule.today.any? %>
          <ol class="family-day">
            <% schedule.today.each do |task| %>
              <li class="<%= 'is-past' if task.past? %><%= ' is-now' if task.happening_at? %><%= ' is-work' if task.work? %>">
                <span class="sched-time"><%= time_range(task, with_day: :never) %></span>
                <span><%= icon(:briefcase) if task.work? %><%= task.title_for(current_user) %><%= " · #{task.place_name}" if task.place_name && task.visible_to?(current_user) %><%= icon(:lock, label: "Private") if task.private? %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="empty-hint">Nothing scheduled today.</p>
        <% end %>
        <% if schedule.todos.any? %>
          <p class="family-todos"><small><%= icon(:list) %><%= pluralize(schedule.todos.size, "to-do") %></small></p>
        <% end %>
      </section>
    <% end %>
  </div>
  <% end %>
  </div>
  <% if @anyone.any? %>
    <h2 class="section-title"><%= icon(:users) %>For anyone</h2>
    <ul class="sched-list"><%= render partial: "tasks/item", collection: @anyone, as: :task %></ul>
  <% end %>
<% else %>
  <% s = @schedule %>
  <%= render "tasks/person_header", person: @person, where: @where, at: @at, now_task: @schedule.now, locations: @locations, schedule: @schedule, status_now: @status_now %>

  <%= render "tasks/schedule_top", s: s, person: @person, where: @where %>

  <%= render "tasks/quick_add", task: @task, person: @person, selected: @assignee_ids, members: @members %>

  <%= render "tasks/schedule_lists", s: s, person: @person, where: @where %>
<% end %>
