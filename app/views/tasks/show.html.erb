<% content_for :title, @task.title %>
<h1><%= @task.title %></h1>
<ul class="sched-list panel"><%= render "tasks/item", task: @task, show_day: true %></ul>
<div class="form-actions"><%= link_to icon_label(:arrow_right, "Back to the schedule"), tasks_path(person: @task.active_assignments.first&.user_id), class: "btn btn-quiet" %></div>
