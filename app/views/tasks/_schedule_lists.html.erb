<%# The day's lists under the quick add: to-dos, today, coming up, following up, done. Locals: s (the PersonSchedule), person, where (their latest
    LocationReport). Its own partial so a quick add can replace it in place. %>
<% me = person == current_user %>
<div id="schedule-lists">
  <div class="schedule-columns" data-controller="auto-refresh" data-auto-refresh-interval-value="60">
    <section class="panel">
      <h2><%= icon(:list) %><%= me ? "To do" : "On their list" %> <span class="count"><%= s.todos.size %></span></h2>
      <% if s.todos.any? %>
        <ul class="sched-list"><%= render partial: "tasks/item", collection: s.todos, as: :task, locals: { schedule_person: person } %></ul>
      <% else %>
        <p class="empty-hint"><%= icon(:sparkles) %><%= me ? "Nothing on your list. Add anything above, as it comes to you." : "Their list is clear." %></p>
      <% end %>
    </section>

    <section class="panel">
      <h2><%= icon(:calendar) %>Today</h2>
      <% if s.today.any? %>
        <ul class="sched-list"><%= render partial: "tasks/item", collection: s.today, as: :task, locals: { schedule_person: person } %></ul>
      <% else %>
        <p class="empty-hint">Nothing at a set time today.</p>
      <% end %>
    </section>
  </div>

  <% if s.later.any? || s.days_off.any? %>
    <h2 class="section-title"><%= icon(:calendar) %>Coming up</h2>
    <ul class="sched-list panel">
      <% s.days_off.each do |off| %>
        <li class="sched-item sched-day-off">
          <span class="sched-time"><%= off.single_day? ? day_name(off.starts_on) : "#{day_name(off.starts_on)} – #{day_name(off.ends_on)}" %></span>
          <div class="sched-body"><span class="sched-title"><%= icon(:sun) %>Day off<%= " · #{off.note}" if off.note %></span></div>
        </li>
      <% end %>
      <%= render partial: "tasks/item", collection: s.later, as: :task, locals: { show_day: true, schedule_person: person } %>
    </ul>
  <% end %>

  <% if s.following.any? %>
    <h2 class="section-title"><%= icon(:bell) %>Following up</h2>
    <ul class="sched-list panel"><%= render partial: "tasks/item", collection: s.following, as: :task, locals: { show_day: true } %></ul>
  <% end %>

  <% done = s.done.reject { |task| s.today.include?(task) } %>
  <% if done.any? %>
    <details class="done-today">
      <summary><%= icon(:check_circle) %>Done today (<%= done.size %>)</summary>
      <ul class="sched-list"><%= render partial: "tasks/item", collection: done, as: :task, locals: { schedule_person: person } %></ul>
    </details>
  <% end %>
</div>
