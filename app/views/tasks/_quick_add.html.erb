<%# The fast way in: type, Enter, type, Enter. "Add a time or day" opens the
    event fields. quick_add_controller.js clears and refocuses the box after
    each add. Locals: task (new, assigned to the person whose page this is). %>
<% mine = task.assigned_to == current_user %>
<%= form_with model: task, url: tasks_path, class: "quick-add", data: { controller: "quick-add", action: "turbo:submit-end->quick-add#added" } do |f| %>
  <%= f.hidden_field :assigned_to_id %>
  <div class="quick-add-row">
    <%= f.label :title, mine ? "Add to your list" : "Add to #{task.assigned_to.display_name}'s list", class: "visually-hidden" %>
    <%= f.text_field :title, required: true, maxlength: 120, autocomplete: "off", enterkeyhint: "done",
                     placeholder: mine ? "Add something… (call the doctor, church at 10)" : "Add something for #{task.assigned_to.display_name}…",
                     data: { quick_add_target: "title" } %>
    <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon_label(:plus, "Add") %><% end %>
  </div>
  <details class="quick-add-more" data-quick-add-target="more">
    <summary><%= icon(:clock) %>Add a time or day</summary>
    <%= render "tasks/when_fields", form: f %>
  </details>
<% end %>
