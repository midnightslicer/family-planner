<% content_for :title, "Join #{@invitation.household.name}" %>
<h1>Join <%= @invitation.household.name %></h1>
<p class="page-intro">
  <%= @invitation.invited_by&.display_name || "Your admin" %> invited you to <%= app_name %>, where everyone can see
  what the others are up to. Create your account below; it takes a few seconds.
</p>
<% if @invitation.note.present? %>
  <blockquote><%= @invitation.note %></blockquote>
<% end %>

<%= render "shared/form_errors", object: @user %>

<div class="form-card">
  <%= form_with model: @user, url: join_invitation_path(params[:token]), method: :post,
                data: { controller: "passkey-signup", passkey_signup_options_url_value: invitation_passkey_options_path(params[:token]) } do |f| %>
    <div class="form-field">
      <%= f.label :display_name, "Your name" %>
      <%= f.text_field :display_name, placeholder: "e.g. Sam", required: true, maxlength: 60, autofocus: true, autocomplete: "name" %>
    </div>
    <div class="form-field">
      <%= f.label :email, "Email" %>
      <% if @invitation.email.present? %>
        <%= f.email_field :email, value: @invitation.email, readonly: true, autocomplete: "email" %>
      <% else %>
        <%= f.email_field :email, required: true, autocomplete: "email" %>
        <small>Used to sign in and to reset your password.</small>
      <% end %>
    </div>

    <%= render "shared/signup_credentials", form: f %>

    <fieldset class="form-field">
      <legend>Your color on the board</legend>
      <%= render "shared/color_picker", form: f %>
    </fieldset>

    <div class="form-actions">
      <%= f.submit "Join", class: "btn btn-primary",
                   data: { passkey_signup_target: "submit", passkey_label: "Join with a passkey", password_label: "Join" } %>
      <button type="button" class="btn btn-quiet" data-passkey-signup-target="toggle" data-action="passkey-signup#toggle" hidden>Use a password instead</button>
    </div>
  <% end %>
  <p class="devise-links"><small>Already have an account? <%= link_to "Sign in", new_user_session_path %> and open this link again.</small></p>
</div>
