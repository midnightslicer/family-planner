<%# Add / edit a pet. The few fields everyone needs come first; feeding has
    its own group because the notes are what the next person reads. %>
<% homes = current_household.locations.in_display_order %>
<%= render "shared/form_errors", object: @pet %>

<div class="form-card">
  <%= form_with model: @pet do |f| %>
    <%= render "shared/photo_picker", form: f, attribute: :photo, preview: pet_avatar_content(@pet),
               style: PetsHelper::PET_DISC_STYLE, autosave: @pet.persisted? %>
    <div class="form-field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, required: true, maxlength: 40, placeholder: "e.g. Biscuit", autocomplete: "off" %>
    </div>
    <div class="form-row">
      <%# "New type…" reveals a name box (CSS, no page change). On a failed save
          the typed name comes back as the species, so keep it selected. %>
      <% typed_kind = @new_species.present? %>
      <div class="form-field new-place-host">
        <%= f.label :species, "What kind of pet?" %>
        <%= f.select :species, options_for_select([["Not set", ""]] + Pet.kinds_for(current_household, @pet.species).map { |kind| [kind, kind] } + [["New type…", Pet::NEW_KIND]],
                                                  typed_kind ? Pet::NEW_KIND : @pet.species) %>
        <div class="new-place-field">
          <%= label_tag "pet_new_species", "Name of the new type" %>
          <%= text_field_tag "pet[new_species]", @new_species, id: "pet_new_species",
                             maxlength: 30, placeholder: "e.g. Alpaca, Guinea pig", autocomplete: "off" %>
          <small>It's added to the menu for everyone in your household.</small>
        </div>
      </div>
      <div class="form-field">
        <%= f.label :birthday, "Birthday (optional)" %>
        <%= f.date_field :birthday, max: Date.current %>
      </div>
    </div>
    <%# Photo tiles; "New house" reveals a name box (CSS, no page change), so
        adding the house never loses what's typed above. %>
    <% new_home = @pet.home&.new_record?
       selected = new_home ? Location::NEW : @pet.home_id %>
    <label class="inline-check visitor-check">
      <%= f.check_box :visitor %>
      <span>We dog-sit them: they come and go</span>
    </label>
    <%# Off for pets that never move (horses in their pasture): the wall has no room to spare,
        and there is nothing to report on the Where page. %>
    <label class="inline-check visitor-check">
      <%= f.check_box :on_wall %>
      <span>Show on the wall</span>
    </label>
    <label class="inline-check visitor-check">
      <%= f.check_box :on_where_page %>
      <span>Show on the Where page</span>
    </label>
    <%= render "shared/location_picker", locations: homes, field_name: "pet[home_id]",
               new_name_field: "pet[new_home_name]", new_name: @new_home_name || (@pet.home.name if new_home),
               selected: selected, legend: "Sleeps at", blank_label: "Not set", new_label: "New house",
               new_prompt: "Name of the new place", new_placeholder: "e.g. Farmhouse, Grandma's",
               new_hint: "It's added to your locations as a house." %>

    <fieldset class="form-field">
      <legend>Feeding</legend>
      <div class="form-field">
        <%= f.label :meals_per_day, "Meals a day" %>
        <%= f.number_field :meals_per_day, min: 0, max: Pet::MAX_MEALS, required: true, inputmode: "numeric", class: "number-input" %>
        <small>The board shows how many it's had today. 0 if nobody here feeds it.</small>
      </div>
      <div class="form-field">
        <%= f.label :feeding_notes, "Feeding notes" %>
        <%= f.text_area :feeding_notes, rows: 4, maxlength: 1000,
                        placeholder: "e.g. 1 cup dry food at 7am and 6pm. Pill hidden in cheese with dinner. No table scraps." %>
        <small>Shown to whoever is feeding: amounts, times of day, medicine, anything to watch for.</small>
      </div>
    </fieldset>

    <div class="form-actions">
      <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon_label(:save, @pet.persisted? ? "Save changes" : "Add #{@pet.name.presence || 'pet'}") %><% end %>
      <%= link_to "Never mind", @pet.persisted? ? pet_path(@pet) : pets_path, class: "btn btn-quiet" %>
    </div>
  <% end %>
</div>
