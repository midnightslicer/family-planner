<% content_for :title, "Pets" %>
<%= render "shared/live" %>

<div class="page-header">
  <h1>Pets</h1>
  <% if @pets.any? %>
    <div class="header-actions">
      <%= link_to new_feeding_path, class: "btn btn-primary" do %><%= icon_label(:utensils, "Feed") %><% end %>
      <%= link_to new_pet_location_path, class: "btn btn-primary" do %><%= icon_label(:map_pin, "Report where") %><% end %>
      <%= link_to new_pet_path, class: "btn btn-quiet" do %><%= icon_label(:plus, "Add a pet") %><% end %>
    </div>
  <% end %>
</div>

<% if @pets.empty? %>
  <div class="empty-state">
    <span class="banner-icon"><%= icon(:paw) %></span>
    <h2>No pets yet</h2>
    <p>Add your pets and everyone can see where they are and whether they've eaten. Anyone in the family can add one.</p>
    <%= link_to new_pet_path, class: "btn btn-primary" do %><%= icon_label(:plus, "Add a pet") %><% end %>
  </div>
<% else %>
  <div class="pet-grid">
    <% @pets.each do |pet| %>
      <%= render "pets/pet_card", pet: pet, status: @statuses.fetch(pet.id) %>
    <% end %>
  </div>
<% end %>
