// family-status service worker, served by PwaController at /service-worker.js
// (scope "/", Cache-Control: no-cache).
//
// Deliberately small. It caches exactly one thing, the offline page, and
// answers every request from the network. The only thing it adds is a
// friendly page instead of the browser's error when a navigation fails
// because the device is offline. It never caches HTML, Turbo responses,
// /cable or the wall (/h/...).

const VERSION = "<%= @version %>"
const CACHE_PREFIX = "family-status-"
const CACHE = `${CACHE_PREFIX}${VERSION}`
const OFFLINE_URL = "/offline.html"

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(CACHE)
      .then((cache) => cache.add(new Request(OFFLINE_URL, { cache: "reload" })))
      .then(() => self.skipWaiting())
  )
})

self.addEventListener("activate", (event) => {
  event.waitUntil((async () => {
    const keys = await caches.keys()
    await Promise.all(keys.filter((key) => key.startsWith(CACHE_PREFIX) && key !== CACHE).map((key) => caches.delete(key)))
    // Lets the browser start the page request while the worker boots, so
    // having a fetch handler doesn't slow navigations down.
    if (self.registration.navigationPreload) await self.registration.navigationPreload.enable()
    await self.clients.claim()
  })())
})

self.addEventListener("fetch", (event) => {
  const request = event.request
  // Only full page loads; everything else (Turbo visits, assets, forms,
  // /cable) goes straight to the network as if there were no worker.
  if (request.mode !== "navigate" || request.method !== "GET") return

  const url = new URL(request.url)
  if (url.origin !== self.location.origin || url.pathname.startsWith("/h/")) return

  event.respondWith((async () => {
    try {
      const preloaded = await event.preloadResponse
      if (preloaded) return preloaded
      return await fetch(request)
    } catch (error) {
      const offline = await caches.match(OFFLINE_URL)
      if (offline) return offline
      throw error
    }
  })())
})
