<% content_for :title, "Edit #{@location.name}" %>
<h1>Edit <%= @location.name %></h1>
<%= render "form" %>

<% if @location.created_by_id == current_user.id || current_user.admin? %>
  <section class="account-section danger-zone">
    <%= button_to location_path(@location), method: :delete, class: "btn btn-danger",
                  form: { data: { turbo_confirm: "Remove #{@location.name}? It disappears from the app; past reports that mention it keep it." } } do %><%= icon_label(:trash, "Remove #{@location.name}") %><% end %>
  </section>
<% end %>
