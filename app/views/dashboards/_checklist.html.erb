<%# Locals: checklist, dismissible (default true; the account page keeps it). %>
<section class="checklist" aria-labelledby="checklist-title">
  <div class="checklist-header">
    <h2 id="checklist-title"><%= icon(:sparkles) %>Getting started</h2>
    <span class="task-meta"><%= checklist.done_count %> of <%= checklist.steps.size %> done</span>
    <%= button_to "Hide", dismiss_checklist_path, class: "btn btn-quiet btn-small" unless local_assigns[:dismissible] == false %>
  </div>
  <div class="checklist-progress" aria-hidden="true"
       style="--progress: <%= (checklist.done_count * 100.0 / [checklist.steps.size, 1].max).round %>%"></div>
  <ol class="checklist-steps">
    <% checklist.steps.each do |step| %>
      <li class="checklist-step<%= ' is-done' if step.done %><%= ' is-skipped' if step.skipped %>">
        <span class="checklist-mark" aria-hidden="true"><%= icon(step.skipped ? :skip : :check) if step.done %></span>
        <div class="checklist-body">
          <strong><%= step.title %></strong><%= tag.span(step.skipped ? " (skipped)" : " (done)", class: "visually-hidden") if step.done %>
          <small><%= step.detail %></small>
        </div>
        <% unless step.done %>
          <div class="checklist-actions">
            <% if step.skippable %>
              <%= button_to "I don't have one", skip_checklist_step_path(step.key), class: "btn btn-small btn-quiet" %>
            <% end %>
            <%= link_to step.path, class: "btn btn-small btn-primary" do %><span><%= step.link_label %></span><%= icon(:arrow_right) %><% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
