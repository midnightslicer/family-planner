<% content_for :title, @household.name %>
<% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>
<%= turbo_stream_from @household, :members %>

<div class="page-header">
  <h1><%= @household.name %></h1>
  <%= link_to tasks_path, class: "btn btn-primary" do %><%= icon_label(:plus, "Add to my day") %><% end %>
</div>

<%= render "dashboards/checklist", checklist: @checklist if @checklist.visible? %>
<%= render "shared/notifications_banner" %>

<% if @pets.any? %>
  <div class="board-tools">
    <span><%= icon(:paw) %>Pets</span>
    <%= link_to new_feeding_path, class: "btn btn-small" do %><%= icon_label(:utensils, "Feed") %><% end %>
    <%= link_to new_pet_location_path, class: "btn btn-small" do %><%= icon_label(:map_pin, "Report where") %><% end %>
  </div>
<% end %>

<%# A section per place people (or pets) are right now (Whereabouts): the
    one you're in on top, then busiest first, "Somewhere else" last unless
    that's where you are. One plain board until anyone is at a place.
    Refreshes each minute too, so cards move as events start and end. %>
<% grouped = @sections.any?(&:location) %>
<div class="house-groups" data-controller="auto-refresh" data-auto-refresh-interval-value="60">
  <% @sections.each do |section| %>
    <section class="house-group" id="<%= section.location ? dom_id(section.location, :board_place) : "board_place_elsewhere" %>">
      <% if grouped %>
        <h2 class="house-title">
          <% if section.location %><%= location_picture(section.location) %><%= section.location.name %><% else %><span class="place-photo"><%= icon(:map_pin) %></span>Somewhere else<% end %>
          <% if section.people.include?(current_user) %><small class="house-here">You're here</small><% end %>
        </h2>
      <% end %>
      <% if section.people.any? %>
        <div class="dashboard-grid">
          <% section.people.each do |member| %>
            <%= render "shared/person_card", user: member, household: @household, status: @statuses[member.id] %>
          <% end %>
        </div>
      <% end %>
      <% if section.pets.any? %>
        <div class="pet-grid">
          <% section.pets.each do |pet| %>
            <%= render "pets/pet_card", pet: pet, status: @pet_statuses.fetch(pet.id) %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<% if @members.size == 1 && current_user.admin? %>
  <p class="empty-hint"><%= icon(:user_plus) %>It's just you so far. <%= link_to "Invite your family", new_admin_invitation_path %> to fill the board.</p>
<% end %>
