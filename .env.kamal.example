# Settings for deploying with Kamal. Copy to .env.kamal (ignored by Git),
# fill in, then `source .env.kamal` before running bin/kamal.
export DEPLOY_SERVER=server.example.com
export DEPLOY_DOMAIN=status.example.com
export KAMAL_REGISTRY_USERNAME=your-user
export KAMAL_REGISTRY_PASSWORD=your-registry-token

# Optional (defaults shown).
# export DEPLOY_SSH_USER=root
# export DEPLOY_ARCH=amd64
# export KAMAL_REGISTRY_SERVER=ghcr.io
